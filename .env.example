# Public URL baked into the production build (safe to commit in .env.production).
# Local dev falls back to /status.json when this is omitted.
VITE_STATUS_DATA_URL=/api/status

# Pages Functions need VAPID_PUBLIC_KEY as a Cloudflare Pages environment
# variable. Keep VAPID_PRIVATE_KEY only on the scheduled Worker secret.
VAPID_PUBLIC_KEY=<generated-public-web-push-key>

# Cloudflare Pages deploy (GitHub Actions only): add CLOUDFLARE_API_TOKEN and
# CLOUDFLARE_ACCOUNT_ID under repo Settings → Secrets → Actions. Never put them in .env files.
