# Public URL baked into the production build (safe to commit in .env.production).
VITE_STATUS_DATA_URL=https://raw.githubusercontent.com/<owner>/<repo>/status-data/status.json

# Cloudflare Pages deploy (GitHub Actions only): add CLOUDFLARE_API_TOKEN and
# CLOUDFLARE_ACCOUNT_ID under repo Settings → Secrets → Actions. Never put them in .env files.
